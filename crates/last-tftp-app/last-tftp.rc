// last-tftp.rc - Windows resource script
// This file is compiled by rc.exe (part of MSVC/Windows SDK)
// and linked into the final exe to provide the application icon.

#include <windows.h>

// Icon group resource (ID 1 = application icon)
IDI_ICON1 ICON DISCARDABLE "resources/icons/icon.ico"

// Version info (optional but recommended)
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "lph12168x"
            VALUE "FileDescription", "last-tftp: modern cross-platform TFTP tool"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "last-tftp"
            VALUE "OriginalFilename", "last-tftp.exe"
            VALUE "ProductName", "last-tftp"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
